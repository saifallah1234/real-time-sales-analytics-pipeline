{
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "postgres",
    "database.dbname": "cdc_project",

    "topic.prefix": "cdc",
    "plugin.name": "pgoutput",
    "time.precision.mode": "connect",

    "slot.name": "cdc_project_slot",
    "publication.name": "cdc_project_publication",
    "publication.autocreate.mode": "filtered",

    "snapshot.mode": "initial",

    "table.include.list": "cdc_schema.customer,cdc_schema.supplier,cdc_schema.product,cdc_schema.sales_invoice,cdc_schema.sales_invoice_item,cdc_schema.purchase_bill,cdc_schema.purchase_bill_item,cdc_schema.inventory_movement"
  }
