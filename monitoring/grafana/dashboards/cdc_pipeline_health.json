          "rawSql": "SELECT subject AS \"Table\", value AS \"Since last update\", status AS \"Status\", detail AS \"Detail\"\nFROM monitoring.check_results\nWHERE check_name = 'table_freshness' AND run_id = (SELECT run_id FROM monitoring.check_results ORDER BY checked_at DESC, id DESC LIMIT 1)\nORDER BY subject"
