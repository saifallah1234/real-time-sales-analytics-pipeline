    {
      "type": "table",
      "title": "Warnings and failures (time range)",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cdc-postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT checked_at AS \"Time\", check_name AS \"Check\", subject AS \"Subject\", status AS \"Status\", detail AS \"Detail\"\nFROM monitoring.check_results\nWHERE status <> 'ok' AND $__timeFilter(checked_at)\nORDER BY checked_at DESC, id DESC\nLIMIT 200"
        }
