# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=cdc_project
PG_USER=saif
PG_PASSWORD=replace_me
PG_SCHEMA=cdc_schema

# Snowflake
SNOWFLAKE_ACCOUNT=replace_me
SNOWFLAKE_USER=replace_me
SNOWFLAKE_PASSWORD=replace_me
SNOWFLAKE_WAREHOUSE=replace_me
# SNOWFLAKE_ROLE=replace_me
SNOWFLAKE_DATABASE=CDC_DATABASE
SNOWFLAKE_SCHEMA=RAW_DATA

# Ingestion
INGESTION_BATCH_SIZE=1000
INGESTION_OVERLAP_MINUTES=5
INGESTION_ADVISORY_LOCK_ID=723303724
INGESTION_LOG_LEVEL=INFO

# CDC load test (optional)
KAFKA_CONNECT_URL=http://localhost:8083
LOAD_TEST_LANDING_SCHEMA=CDC_LANDING
LOAD_TEST_TIMEOUT_SECONDS=300
LOAD_TEST_POLL_INTERVAL_SECONDS=1
LOAD_TEST_CLEANUP_QUIET_SECONDS=5
LOAD_TEST_REPORT_DIR=reports

# Pipeline monitoring (cdc-monitor / monitoring_dag)
MONITOR_EXPECTED_CONNECTORS=debezium-postgres,snowflake-cdc-sink
MONITOR_SLOT_LAG_WARN_BYTES=104857600
# 0 records table age without warning on it
MONITOR_FRESHNESS_WARN_SECONDS=0
MONITOR_RETENTION_DAYS=7
